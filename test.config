// Test configuration with reduced resources for CI/test environments

process {
    container = 'xiang2019/rnaseq_cmd:v1.0.0'
    cpus   = 2
    memory = '4 GB'
    time   = '1h'

    withName: STAR_INDEX {
        cpus      = 2
        memory    = '8 GB'
        container = 'quay.io/biocontainers/star:2.7.11b--h5ca1c30_6'
        time      = '1h'
    }

    withName: ALIGN {
        cpus      = 2
        memory    = '8 GB'
        container = 'quay.io/biocontainers/star:2.7.11b--h5ca1c30_6'
        time      = '1h'
        maxForks  = 1
    }

    withName: TRIM {
        cpus      = 2
        container = 'staphb/fastp:0.24.0'
    }

    withName: FEATURECOUNT {
        cpus = 2
    }

    withName: MULTIQC {
        cpus      = 1
        memory    = '2 GB'
        time      = '30m'
        container = 'multiqc/multiqc:pdf-v1.34'
    }
}

// Docker configuration
docker {
    enabled    = true
    runOptions = '--rm --platform linux/amd64'
    sudo       = true
}

// Reporting
report {
    enabled = true
    file    = "${params.outdir}/pipeline_report.html"
}

timeline {
    enabled = true
    file    = "${params.outdir}/timeline.html"
}

// Parameters
params {
    cpus = 2
    ram  = 8000000000  // 8GB
}
