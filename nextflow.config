profiles {
	standard {
		process {
			executor = 'local'
			cpus = 8
			memory = '64G'
			container = 'xiang2019/rnaseq_cmd:v1.0.0'
		}
	}
	awsbatch {
		accessKey = ''
		secretKey = ''
		region = 'us-east-1'
		process {
			executor = 'awsbatch'
			cpus = 8
			memory = '64G'
		}
		fusion {
			enabled = true
		}
	}
}


// Default parameters
params {
    gtf      = null
    outdir   = 'results'
    single_end = false
}

// Process configuration
process {
    container = 'xiang2019/rnaseq_cmd:v1.0.0'
    cpus   = 8
    memory = '32 GB'
    time   = '12h'

    withName: STAR_INDEX {
        cpus      = 16
        memory    = '64 GB'
        container = 'quay.io/biocontainers/star:2.7.11b--h5ca1c30_6'
        time      = '12h'
    }

    withName: ALIGN {
        cpus      = 16
        memory    = '64 GB'
        container = 'quay.io/biocontainers/star:2.7.11b--h5ca1c30_6'
        time      = '12h'
    }

    withName: TRIM {
        container = 'staphb/fastp:0.24.0'
    }

    withName: FEATURECOUNT {
        cpus = 8
    }

    withName: MULTIQC {
        cpus      = 2
        memory    = '8 GB'
        time      = '1h'
        container = 'multiqc/multiqc:pdf-v1.34'
    }
}

// Docker configuration
docker {
    enabled    = true
    runOptions = '--rm --platform linux/amd64'
}

// Reporting
report {
    enabled = true
    file    = "${params.outdir}/pipeline_report.html"
}

timeline {
    enabled = true
    file    = "${params.outdir}/timeline.html"
}

// Manifest
manifest {
    name            = 'RNA-sequence Analysis Pipeline'
    author          = 'Xiang Ye'
    description     = 'Nextflow pipeline for RNA-seq'
    version         = '1.0.0'
    nextflowVersion = '>=21.04.0'
}
